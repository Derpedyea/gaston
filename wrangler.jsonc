{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gaston-pr-reviewer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health*", "/webhooks/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "REVIEWER", "class_name": "Reviewer" }]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Reviewer"] }
  ],

  "queues": {
    "producers": [{ "binding": "REVIEW_QUEUE", "queue": "gaston-reviews" }],
    "consumers": [
      {
        "queue": "gaston-reviews",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "gaston-reviews-dlq",
        "max_concurrency": 3
      }
    ]
  },

  "vars": {
    "DASHBOARD_URL": "https://gaston-pr-reviewer.mineperial.workers.dev",
    "REVIEW_MIN_CONFIDENCE": "0.82",
    "REVIEW_MAX_FINDINGS": "8",
    "REQUEST_CHANGES_ON": "blocker",
    "REVIEW_MODEL": "deepseek/deepseek-v4-flash-0731:exacto",
    "REVIEW_REASONING_EFFORT": "high",
    "REVIEW_MODEL_MAX_OUTPUT_TOKENS": "64000",
    "REVIEW_MAX_WALL_TIME_MS": "840000",
    "REVIEW_MODEL_TIMEOUT_MS": "660000",
    "REVIEW_MAX_MODEL_REQUESTS": "9",
    "REVIEW_MAX_INPUT_TOKENS": "250000",
    "REVIEW_MAX_OUTPUT_TOKENS": "128000",
    "REVIEW_MAX_COST_USD": "0.20",
    "REVIEWER_GENERATION": "14"
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },

  "limits": { "cpu_ms": 300000 }
}
