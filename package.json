{
  "name": "gaston-pr-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Precision-oriented, budget-bounded GitHub PR reviews with a Cloudflare Computer-backed agent harness.",
  "scripts": {
    "dev": "wrangler dev",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "predeploy": "bun run build:ui",
    "deploy": "wrangler deploy",
    "check": "wrangler types && tsc --noEmit && vitest run && bun run check:privacy && bun run eval:historical && bun run eval:harness",
    "check:privacy": "bun tools/check-public-tree.ts",
    "diagnose:pr": "bun tools/diagnose-pr.mjs",
    "eval:harness": "bun tools/run-harness-eval.ts",
    "eval:models": "bun tools/run-recent-pr-bench.ts",
    "eval:historical": "bun tools/validate-historical-corpus.ts",
    "fixtures:capture": "bun tools/capture-historical-prs.ts",
    "test": "vitest run",
    "types:generate": "wrangler types",
    "types:check": "wrangler types --check",
    "pretypecheck": "wrangler types",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/computer": "0.1.1",
    "@fontsource-variable/inter": "5.3.0",
    "@heroicons/react": "2.2.0",
    "@pierre/diffs": "1.3.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.3.14"
}
